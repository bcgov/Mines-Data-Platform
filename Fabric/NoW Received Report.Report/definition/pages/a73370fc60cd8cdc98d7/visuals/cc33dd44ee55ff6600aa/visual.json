                "textRuns": [
                  {
                    "value": "Counts are distinct Notice of Work applications received — New Permits and Amendments — excluding administrative amendments, based on the application submitted date.",
                    "textStyle": {
                      "fontSize": "12px",
                      "color": "#252423",
                      "fontFamily": "BC Sans"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The left chart shows NoWs received per fiscal year (FY2021/22–FY2025/26). The right chart shows NoWs received by fiscal month from April 2023, broken down by type. Both split into two series: New Permit and Amendments.",
                    "textStyle": {
                      "fontSize": "12px",
                      "color": "#252423",
                      "fontFamily": "BC Sans"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Data reflects the current gold layer; received-application counts read light on the current extract and will rise once the now_application source is refreshed.",
