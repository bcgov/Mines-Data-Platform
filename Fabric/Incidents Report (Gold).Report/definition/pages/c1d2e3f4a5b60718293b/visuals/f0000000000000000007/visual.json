                ]
              },
              {
                "textRuns": [
                  {
                    "value": "2.  Categories only exist from 21 May 2018.",
                    "textStyle": {
                      "fontSize": "11px",
                      "color": "#013366",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "   Verified at source 10 Sep 2026: none before, 93 % after. CORE changed classification; no earlier grouping survives.",
                    "textStyle": {
                      "fontSize": "11px",
                      "color": "#252423"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "3.  Three bad source rows.",
                    "textStyle": {
                      "fontSize": "11px",
                      "color": "#013366",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "   One dated 22 Aug 2040; incident 4622 keyed 200,000 fatalities; 4659 keyed 1,234 injuries. All excluded from the affected measures.",
