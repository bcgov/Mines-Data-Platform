				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "SELECT DISTINCT\n    loc.location_id,\n    ISNULL(il.inspection_id, -1)                          AS inspection_id,   -- default unknown\n    NULLIF(LTRIM(RTRIM(loc.description)), '')             AS LocationDescription,\n    NULLIF(LTRIM(RTRIM(loc.notes)), '')                   AS LocationNotes,\n    TRY_CONVERT(float,  NULLIF(LTRIM(RTRIM(loc.latitude)),  ''))  AS latitude,\n    TRY_CONVERT(float,  NULLIF(LTRIM(RTRIM(loc.longitude)), ''))  AS longitude,\n    TRY_CONVERT(float,  NULLIF(LTRIM(RTRIM(loc.utm_easting)), ''))   AS utm_easting,\n    TRY_CONVERT(float,  NULLIF(LTRIM(RTRIM(loc.utm_northing)), ''))  AS utm_northing,\n    TRY_CONVERT(int,    NULLIF(LTRIM(RTRIM(loc.zone_number)), ''))   AS zone_number,\n    LEFT(LTRIM(RTRIM(loc.zone_letter)), 1)                AS zone_letter,\n    NULLIF(LTRIM(RTRIM(ilt.inspected_location_type)), '') AS InspectedLocationType\nFROM [stg].[nris_location]               loc\nLEFT JOIN [stg].[nris_inspected_location]       il  ON il.location_id = loc.location_id\nLEFT JOIN [stg].[nris_inspected_location_type]  ilt ON ilt.inspected_location_type_id = il.inspected_location_type_id;",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
