table fact_mine_incident
	lineageTag: eb257beb-5cd7-413a-96b9-b745a4fcaa17
	sourceLineageTag: [gold].[fact_mine_incident]

	/// All-time distinct count of incidents in gold. Base measure.
	measure 'Incidents Total' = DISTINCTCOUNT ( fact_mine_incident[mine_incident_id] )
		formatString: #,##0
		displayFolder: Incidents KPIs
		lineageTag: a2c06b29-29e2-4ecd-a7db-82a219aada07

	/// KPI card 1. Current BC fiscal year (1 Apr -> today inclusive) on the EFFECTIVE date: Rajneesh's rule - if an incident was reported more than 24h after it happened, the incident time is used instead of the reported time. Mirrors Metabase question 3284.
	measure 'Incidents FYTD' = VAR d = TODAY() VAR fyStart = IF ( MONTH ( d ) >= 4, YEAR ( d ), YEAR ( d ) - 1 ) RETURN CALCULATE ( DISTINCTCOUNT ( fact_mine_incident[mine_incident_id] ), fact_mine_incident[effective_date] >= DATE ( fyStart, 4, 1 ), fact_mine_incident[effective_date] < d + 1 )
		formatString: #,##0
		displayFolder: Incidents KPIs
		lineageTag: df06b020-8c0e-4571-824f-e1abe7370aa8

	/// KPI card 2. Previous FY from 1 Apr to the same calendar day one year ago, effective date. Mirrors Metabase 3285 but uses the fiscal-year-safe window (the Metabase version mis-computes the window from January to March).
	measure 'Incidents Same Time Last FY' = VAR d = TODAY() VAR fyStart = IF ( MONTH ( d ) >= 4, YEAR ( d ), YEAR ( d ) - 1 ) VAR lastStart = DATE ( fyStart - 1, 4, 1 ) VAR lastSame = DATE ( YEAR ( d ) - 1, MONTH ( d ), DAY ( d ) ) RETURN CALCULATE ( DISTINCTCOUNT ( fact_mine_incident[mine_incident_id] ), fact_mine_incident[effective_date] >= lastStart, fact_mine_incident[effective_date] < lastSame + 1 )
		formatString: #,##0
		displayFolder: Incidents KPIs
		lineageTag: c30f3a35-310c-40c7-80c4-10bb48140be0

	/// KPI card 3. LAST COMPLETED CALENDAR MONTH on the effective date (not rolling 30 days - incidents and NoW use the calendar month; Inspections uses rolling 30). Mirrors Metabase 3288 without its 31st-of-month zero bug.
	measure 'Incidents Last Month' = VAR d = TODAY() VAR mStart = EOMONTH ( d, -2 ) + 1 VAR mEnd = EOMONTH ( d, -1 ) + 1 RETURN CALCULATE ( DISTINCTCOUNT ( fact_mine_incident[mine_incident_id] ), fact_mine_incident[effective_date] >= mStart, fact_mine_incident[effective_date] < mEnd )
		formatString: #,##0
		displayFolder: Incidents KPIs
		lineageTag: a07b85b7-888e-4b77-8c7a-3138fdb2c544

	/// FYTD minus same time last FY. Comparable windows.
	measure 'Incidents YoY Delta' = [Incidents FYTD] - [Incidents Same Time Last FY]
		formatString: +#,##0;-#,##0;0
		displayFolder: Incidents KPIs
		lineageTag: 5cdd559b-40dc-4532-b778-fecdcab38bbe

	/// FYTD change versus same time last FY, as a percentage.
	measure 'Incidents YoY Delta %' = DIVIDE ( [Incidents FYTD] - [Incidents Same Time Last FY], [Incidents Same Time Last FY] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Incidents KPIs
		lineageTag: 9615b51b-e449-4dae-b484-2be261604494

	/// Chart 1, green bars. Last 5 COMPLETED fiscal years on the EFFECTIVE date, current FY excluded. Window matches Metabase 3287; the date basis follows Rajneesh 10 Sep 2026 - the 24-hour rule applies to charts as well as cards, per Caroline. Axis: dim_date[fiscal_year_label].
	measure 'Incidents per Fiscal Year' = VAR d = TODAY() VAR fyStart = IF ( MONTH ( d ) >= 4, YEAR ( d ), YEAR ( d ) - 1 ) RETURN CALCULATE ( DISTINCTCOUNT ( fact_mine_incident[mine_incident_id] ), USERELATIONSHIP ( fact_mine_incident[Effective_Date_SK], dim_date[Date_SK] ), fact_mine_incident[effective_date] >= DATE ( fyStart - 5, 4, 1 ), fact_mine_incident[effective_date] < DATE ( fyStart, 4, 1 ) )
		formatString: #,##0
		displayFolder: Incidents Trend
		lineageTag: ddd78c25-f888-47b8-8917-d3a482ec3e83

	/// Chart 1, blue bars. Dangerous Occurrences (determination_type_code = 'DO') in the same window, effective date.
	measure 'DOs per Fiscal Year' = VAR d = TODAY() VAR fyStart = IF ( MONTH ( d ) >= 4, YEAR ( d ), YEAR ( d ) - 1 ) RETURN CALCULATE ( DISTINCTCOUNT ( fact_mine_incident[mine_incident_id] ), USERELATIONSHIP ( fact_mine_incident[Effective_Date_SK], dim_date[Date_SK] ), fact_mine_incident[is_dangerous_occurrence] = 1, fact_mine_incident[effective_date] >= DATE ( fyStart - 5, 4, 1 ), fact_mine_incident[effective_date] < DATE ( fyStart, 4, 1 ) )
		formatString: #,##0
		displayFolder: Incidents Trend
		lineageTag: a687b739-6d65-4d9a-8f0a-0638f334d6ae

	/// Chart 2 series 1. Monthly incidents on the EFFECTIVE date, trailing 4 years including the current partial month - exactly Metabase 3289 (titled 'last 3 years' there, but the SQL is 4). Axis: dim_date[fiscal_month_label].
	measure 'Incidents per Month' = VAR d = TODAY() VAR wStart = DATE ( YEAR ( d ) - 4, MONTH ( d ), 1 ) VAR wEnd = EOMONTH ( d, 0 ) + 1 RETURN CALCULATE ( DISTINCTCOUNT ( fact_mine_incident[mine_incident_id] ), USERELATIONSHIP ( fact_mine_incident[Effective_Date_SK], dim_date[Date_SK] ), fact_mine_incident[effective_date] >= wStart, fact_mine_incident[effective_date] < wEnd )
		formatString: #,##0
		displayFolder: Incidents Trend
		lineageTag: 72404477-20f0-436c-9024-37a7cf20516c

	/// Chart 2 series 2. Dangerous Occurrences per month.
	measure 'DOs per Month' = VAR d = TODAY() VAR wStart = DATE ( YEAR ( d ) - 4, MONTH ( d ), 1 ) VAR wEnd = EOMONTH ( d, 0 ) + 1 RETURN CALCULATE ( DISTINCTCOUNT ( fact_mine_incident[mine_incident_id] ), USERELATIONSHIP ( fact_mine_incident[Effective_Date_SK], dim_date[Date_SK] ), fact_mine_incident[is_dangerous_occurrence] = 1, fact_mine_incident[effective_date] >= wStart, fact_mine_incident[effective_date] < wEnd )
		formatString: #,##0
		displayFolder: Incidents Trend
		lineageTag: d0f0160e-f7c4-43ff-9424-c0736cecd459

	/// Chart 2 series 3. SUM of number_of_injuries (not a count of incidents).
	measure 'Injuries per Month' = VAR d = TODAY() VAR wStart = DATE ( YEAR ( d ) - 4, MONTH ( d ), 1 ) VAR wEnd = EOMONTH ( d, 0 ) + 1 RETURN CALCULATE ( SUM ( fact_mine_incident[number_of_injuries] ), USERELATIONSHIP ( fact_mine_incident[Effective_Date_SK], dim_date[Date_SK] ), fact_mine_incident[effective_date] >= wStart, fact_mine_incident[effective_date] < wEnd )
		formatString: #,##0
		displayFolder: Incidents Trend
		lineageTag: dd44daac-b7c7-4b75-8497-80a550fe7f27

	/// Chart 2 series 4. SUM of number_of_fatalities.
	measure 'Fatalities per Month' = VAR d = TODAY() VAR wStart = DATE ( YEAR ( d ) - 4, MONTH ( d ), 1 ) VAR wEnd = EOMONTH ( d, 0 ) + 1 RETURN CALCULATE ( SUM ( fact_mine_incident[number_of_fatalities] ), USERELATIONSHIP ( fact_mine_incident[Effective_Date_SK], dim_date[Date_SK] ), fact_mine_incident[effective_date] >= wStart, fact_mine_incident[effective_date] < wEnd )
		formatString: #,##0
		displayFolder: Incidents Trend
		lineageTag: 70a2bc01-64ab-4f96-9c8b-ae12480f99be

	/// Distinct incidents flagged DO in the current filter context.
	measure 'DOs Total' = CALCULATE ( DISTINCTCOUNT ( fact_mine_incident[mine_incident_id] ), fact_mine_incident[is_dangerous_occurrence] = 1 )
		formatString: #,##0
		displayFolder: Dangerous Occurrences
		lineageTag: 4d1a4dca-e46b-47ea-b126-d39e04c0446c

	/// Share of incidents that are Dangerous Occurrences. Colin's steer (17 Jul): DOs, not raw volume, are what the Chief Inspector watches.
	measure 'DO Share %' = DIVIDE ( [DOs Total], [Incidents Total] )
		formatString: 0.0%
		displayFolder: Dangerous Occurrences
		lineageTag: 7e3d4cb9-1982-4a0b-a702-59bb27c96db1

	/// Distinct incidents per category via bridge_incident_category. An incident with two categories counts once in each and once in the total - do not SUM this across categories. Axis: dim_incident_category[category_group].
	measure 'Incidents by Category' = DISTINCTCOUNT ( fact_mine_incident[mine_incident_id] )
		formatString: #,##0
		displayFolder: By Category
		lineageTag: 40972968-6741-45d0-a875-97827db4f1f7

	/// Same, excluding the explicit Uncategorised member. Only ~47% of incidents carry a category at source.
	measure 'Incidents by Category (categorised only)' = CALCULATE ( DISTINCTCOUNT ( fact_mine_incident[mine_incident_id] ), bridge_incident_category[is_uncategorised] = 0 )
		formatString: #,##0
		displayFolder: By Category
		lineageTag: 0a7e10db-434c-47db-b3b6-9313d6d109a6

	/// Share of incidents with no category at all. Design question for Caroline / Romil.
	measure 'Uncategorised Share %' = DIVIDE ( CALCULATE ( DISTINCTCOUNT ( fact_mine_incident[mine_incident_id] ), bridge_incident_category[is_uncategorised] = 1 ), [Incidents Total] )
		formatString: 0.0%
		displayFolder: By Category
		lineageTag: c9c786f6-fed0-4e67-8638-0c773c068aea

	/// Reconciliation only. Same window as 'Incidents per Fiscal Year' but on the RAW reported date - i.e. what Metabase 3287 returns today. Keep for tie-outs against the Metabase report; not for the published visual.
	measure 'Incidents per Fiscal Year (Reported Date)' = VAR d = TODAY() VAR fyStart = IF ( MONTH ( d ) >= 4, YEAR ( d ), YEAR ( d ) - 1 ) RETURN CALCULATE ( DISTINCTCOUNT ( fact_mine_incident[mine_incident_id] ), fact_mine_incident[reported_date] >= DATE ( fyStart - 5, 4, 1 ), fact_mine_incident[reported_date] < DATE ( fyStart, 4, 1 ) )
		formatString: #,##0
		displayFolder: Incidents Trend
		lineageTag: 1afea0d6-7624-4fdd-bf72-07f2c6aff7c8

	/// Chart 3 value. Distinct incidents per PARENT category group, on the effective date, scoped to 21 May 2018 onward and excluding the Uncategorised member. Verified at source 10 Sep 2026: categorisation begins 21 May 2018 - zero categorised incidents before that date, 93% after - so an all-history view would be 50% Uncategorised for reasons that have nothing to do with data quality. Self-trimming: returns BLANK outside the top 5, so the visual needs no filter of its own. An incident with two categories counts once in each group; do not SUM across groups.
	measure 'Incidents by Category (Top 5)' = VAR Base = CALCULATE ( DISTINCTCOUNT ( fact_mine_incident[mine_incident_id] ), USERELATIONSHIP ( fact_mine_incident[Effective_Date_SK], dim_date[Date_SK] ), fact_mine_incident[effective_date] >= DATE ( 2018, 5, 21 ), bridge_incident_category[is_uncategorised] = 0 ) VAR Ranked = RANKX ( ALLSELECTED ( dim_incident_category[category_group] ), CALCULATE ( DISTINCTCOUNT ( fact_mine_incident[mine_incident_id] ), USERELATIONSHIP ( fact_mine_incident[Effective_Date_SK], dim_date[Date_SK] ), fact_mine_incident[effective_date] >= DATE ( 2018, 5, 21 ), bridge_incident_category[is_uncategorised] = 0 ), , DESC, DENSE ) RETURN IF ( ISBLANK ( Ranked ) || Ranked <= 5, Base )
		formatString: #,##0
		displayFolder: By Category
		lineageTag: a76c4601-fe7d-4e4d-b5eb-2d61aa391900

	/// Hidden 1/0 flag. Ranks the parent category groups by incident count and keeps the top 5 - Rajneesh 10 Sep 2026. Apply as a visual-level filter (is 1) on the category chart.
	measure 'Is Top 5 Category' = VAR cat = SELECTEDVALUE ( dim_incident_category[category_group] ) VAR r = RANKX ( ALLSELECTED ( dim_incident_category[category_group] ), [Incidents by Category (Top 5)], , DESC, DENSE ) RETURN IF ( NOT ISBLANK ( cat ) && NOT ISBLANK ( r ) && r <= 5, 1, 0 )
		formatString: 0
		isHidden
		lineageTag: 81f80553-8c4d-4fb1-8b16-c63d33d80bd4

	/// Subtitle for the category chart. States the 2018 scope so nobody reads the chart as all-history.
	measure 'Category Scope Label' = "Top 5 categories, May 2018 onward - categories were not recorded before then"
		displayFolder: Card Labels
		lineageTag: 9b32df5b-20c1-4fc1-af16-0143aa8bfc02

	/// Freshness label. Latest reported date in gold, ignoring future-dated records - one incident is keyed 22 Aug 2040 at source. Never typed in.
	measure 'Data As Of Label' = VAR latest = CALCULATE ( MAX ( fact_mine_incident[reported_date] ), fact_mine_incident[reported_date] <= TODAY() ) RETURN "Data current through " & FORMAT ( latest, "d MMM yyyy" )
		displayFolder: Card Labels
		lineageTag: d4adbf4c-49e2-49e1-9c5e-a1d9fe27c51d

	/// Card 1 title, e.g. 'Number of Incidents FYTD 26/27'.
	measure 'FYTD Label' = VAR d = TODAY() VAR fy = IF ( MONTH ( d ) >= 4, YEAR ( d ), YEAR ( d ) - 1 ) RETURN "Number of Incidents FYTD " & RIGHT ( fy, 2 ) & "/" & RIGHT ( fy + 1, 2 )
		displayFolder: Card Labels
		lineageTag: 62b195f1-17a3-4e84-8e4a-a2a72e9da076

	/// Card 2 title.
	measure 'Same Time Last FY Label' = VAR d = TODAY() VAR fy = IF ( MONTH ( d ) >= 4, YEAR ( d ), YEAR ( d ) - 1 ) RETURN "Number of Incidents same time last FY " & RIGHT ( fy - 1, 2 ) & "/" & RIGHT ( fy, 2 )
		displayFolder: Card Labels
		lineageTag: 807a05b4-3411-4dd9-8678-af524011d67d

	/// Card 3 title, derived from the calendar - the Metabase card is hand-titled and goes stale.
	measure 'Last Month Label' = VAR lm = EOMONTH ( TODAY(), -1 ) VAR fy = IF ( MONTH ( lm ) >= 4, YEAR ( lm ), YEAR ( lm ) - 1 ) RETURN "Number of Incidents Last Month " & FORMAT ( lm, "MMMM" ) & " FY " & RIGHT ( fy, 2 ) & "/" & RIGHT ( fy + 1, 2 )
		displayFolder: Card Labels
		lineageTag: 5fe9756c-aae0-4923-89f1-f97896e6405f

	/// Hidden 1/0 flag: fiscal year is one of the 5 completed FYs. Visual-level filter for chart 1's axis.
	measure 'Is Last 5 FY' = VAR curFY = YEAR ( TODAY() ) - IF ( MONTH ( TODAY() ) >= 4, 0, 1 ) VAR fy = SELECTEDVALUE ( dim_date[fiscal_year] ) RETURN IF ( NOT ISBLANK ( fy ) && fy >= curFY - 5 && fy < curFY, 1, 0 )
		formatString: 0
		isHidden
		lineageTag: 8929bfaf-b4a8-4c60-8a15-27f49e2eae78

	/// Hidden 1/0 flag for chart 2's month axis (trailing 4 years, current partial month included). Works off dim_date[full_date] so it does not depend on how fiscal_year_month_key is encoded. The measures themselves are windowed on the fact - this only trims empty axis members.
	measure 'Is Last 4 Years Month' = VAR d = TODAY() VAR firstDay = MIN ( dim_date[full_date] ) RETURN IF ( NOT ISBLANK ( firstDay ) && firstDay >= DATE ( YEAR ( d ) - 4, MONTH ( d ), 1 ) && firstDay <= d, 1, 0 )
		formatString: 0
		isHidden
		lineageTag: 35fe75f7-7354-4650-88cb-63529f8ec926

	/// KPI 2. Last 30 days including today, effective date.
	measure 'Incidents Rolling 30 Days' = VAR d = TODAY() RETURN CALCULATE ( DISTINCTCOUNT ( fact_mine_incident[mine_incident_id] ), fact_mine_incident[effective_date] > d - 30, fact_mine_incident[effective_date] < d + 1 )
		formatString: #,##0
		displayFolder: Enhanced
		lineageTag: 5f66505c-ed4b-4581-95e1-5f7baa5daf1e

	/// The 30 days before the rolling window.
	measure 'Incidents Prior 30 Days' = VAR d = TODAY() RETURN CALCULATE ( DISTINCTCOUNT ( fact_mine_incident[mine_incident_id] ), fact_mine_incident[effective_date] > d - 60, fact_mine_incident[effective_date] <= d - 30 )
		formatString: #,##0
		displayFolder: Enhanced
		lineageTag: 85c56327-f632-4b87-9a25-fb816d4453b4

	/// KPI 3. Dangerous Occurrences, current FY to date, effective date.
	measure 'DOs FYTD' = VAR d = TODAY() VAR fyStart = IF ( MONTH ( d ) >= 4, YEAR ( d ), YEAR ( d ) - 1 ) RETURN CALCULATE ( DISTINCTCOUNT ( fact_mine_incident[mine_incident_id] ), fact_mine_incident[is_dangerous_occurrence] = 1, fact_mine_incident[effective_date] >= DATE ( fyStart, 4, 1 ), fact_mine_incident[effective_date] < d + 1 )
		formatString: #,##0
		displayFolder: Enhanced
		lineageTag: 664ee1f2-770c-4b4c-bcab-9d633ad98fb6

	/// Comparison window for KPI 3.
	measure 'DOs Same Time Last FY' = VAR d = TODAY() VAR fyStart = IF ( MONTH ( d ) >= 4, YEAR ( d ), YEAR ( d ) - 1 ) VAR lastStart = DATE ( fyStart - 1, 4, 1 ) VAR lastSame = DATE ( YEAR ( d ) - 1, MONTH ( d ), DAY ( d ) ) RETURN CALCULATE ( DISTINCTCOUNT ( fact_mine_incident[mine_incident_id] ), fact_mine_incident[is_dangerous_occurrence] = 1, fact_mine_incident[effective_date] >= lastStart, fact_mine_incident[effective_date] < lastSame + 1 )
		formatString: #,##0
		displayFolder: Enhanced
		lineageTag: 0306ab6c-b488-4fc8-a2a2-7b9de351829d

	/// DOs as a share of all incidents FYTD.
	measure 'DO Share FYTD %' = DIVIDE ( [DOs FYTD], [Incidents FYTD] )
		formatString: 0%
		displayFolder: Enhanced
		lineageTag: b468f627-ee5c-4fd7-abee-d9ce5e8e0463

	/// KPI 4. Sum of number_of_injuries, current FY to date.
	measure 'Injuries FYTD' = VAR d = TODAY() VAR fyStart = IF ( MONTH ( d ) >= 4, YEAR ( d ), YEAR ( d ) - 1 ) RETURN CALCULATE ( SUM ( fact_mine_incident[number_of_injuries] ), fact_mine_incident[effective_date] >= DATE ( fyStart, 4, 1 ), fact_mine_incident[effective_date] < d + 1 )
		formatString: #,##0
		displayFolder: Enhanced
		lineageTag: d1129d46-f656-4e79-a301-723d943df791

	/// Comparison window for KPI 4.
	measure 'Injuries Same Time Last FY' = VAR d = TODAY() VAR fyStart = IF ( MONTH ( d ) >= 4, YEAR ( d ), YEAR ( d ) - 1 ) VAR lastStart = DATE ( fyStart - 1, 4, 1 ) VAR lastSame = DATE ( YEAR ( d ) - 1, MONTH ( d ), DAY ( d ) ) RETURN CALCULATE ( SUM ( fact_mine_incident[number_of_injuries] ), fact_mine_incident[effective_date] >= lastStart, fact_mine_incident[effective_date] < lastSame + 1 )
		formatString: #,##0
		displayFolder: Enhanced
		lineageTag: 8b0cc178-174e-468f-811b-818505bb45ca

	/// KPI 5. Sum of number_of_fatalities, current FY to date.
	measure 'Fatalities FYTD' = VAR d = TODAY() VAR fyStart = IF ( MONTH ( d ) >= 4, YEAR ( d ), YEAR ( d ) - 1 ) RETURN CALCULATE ( SUM ( fact_mine_incident[number_of_fatalities] ), fact_mine_incident[effective_date] >= DATE ( fyStart, 4, 1 ), fact_mine_incident[effective_date] < d + 1 )
		formatString: #,##0
		displayFolder: Enhanced
		lineageTag: 153a15b3-bced-4d1a-8329-c1641525cc51

	/// Comparison window for KPI 5.
	measure 'Fatalities Same Time Last FY' = VAR d = TODAY() VAR fyStart = IF ( MONTH ( d ) >= 4, YEAR ( d ), YEAR ( d ) - 1 ) VAR lastStart = DATE ( fyStart - 1, 4, 1 ) VAR lastSame = DATE ( YEAR ( d ) - 1, MONTH ( d ), DAY ( d ) ) RETURN CALCULATE ( SUM ( fact_mine_incident[number_of_fatalities] ), fact_mine_incident[effective_date] >= lastStart, fact_mine_incident[effective_date] < lastSame + 1 )
		formatString: #,##0
		displayFolder: Enhanced
		lineageTag: 608079ca-d3d0-490e-af62-96cb7dffbfa3

	/// Effective date of the latest incident with a fatality.
	measure 'Most Recent Fatality Date' = CALCULATE ( MAX ( fact_mine_incident[effective_date] ), fact_mine_incident[number_of_fatalities] > 0, fact_mine_incident[effective_date] <= TODAY() )
		formatString: d MMM yyyy
		displayFolder: Enhanced
		lineageTag: f8a1250e-7a74-4a82-a492-6a7d26cadd63

	/// KPI title, Incidents.
	measure 'Incidents Title' = VAR d = TODAY() VAR fyStart = IF ( MONTH ( d ) >= 4, YEAR ( d ), YEAR ( d ) - 1 ) RETURN "INCIDENTS — FYTD " & RIGHT ( fyStart, 2 ) & "/" & RIGHT ( fyStart + 1, 2 )
		displayFolder: Enhanced
		lineageTag: d400acf6-b0e3-4141-b10d-0edc6aad35f7

	/// Delta pill text, Incidents.
	measure 'Incidents Pill' = VAR c = [Incidents FYTD] VAR p = [Incidents Same Time Last FY] RETURN IF ( ISBLANK ( p ) || ( p = 0 && c = 0 ), "— no comparison", IF ( p = 0, "▲ new", IF ( c > p, "▲ " & FORMAT ( DIVIDE ( c - p, p ), "0%" ) & " higher", IF ( c < p, "▼ " & FORMAT ( DIVIDE ( p - c, p ), "0%" ) & " lower", "— unchanged" ) ) ) )
		displayFolder: Enhanced
		lineageTag: 83974e7f-a9a1-402a-aac2-ed9ac1cf9f03

	/// Pill font colour (hex). Higher is worse for every KPI on this page.
	measure 'Incidents Pill Color' = VAR c = [Incidents FYTD] VAR p = [Incidents Same Time Last FY] RETURN IF ( ISBLANK ( p ) || c = p, "#605E5C", IF ( c > p, "#CE3E39", "#2E8540" ) )
		displayFolder: Enhanced
		lineageTag: 7e82b2a8-383d-4fa4-ade9-c852ee2a4283

	/// Pill background colour (hex).
	measure 'Incidents Pill Tint' = VAR c = [Incidents FYTD] VAR p = [Incidents Same Time Last FY] RETURN IF ( ISBLANK ( p ) || c = p, "#EEF1F4", IF ( c > p, "#FDECEA", "#E6F4EA" ) )
		displayFolder: Enhanced
		lineageTag: 81eff55e-a3f1-4a2b-b026-c95e7ec516d8

	/// Grey text beside the pill.
	measure 'Incidents Period' = VAR d = TODAY() VAR fyStart = IF ( MONTH ( d ) >= 4, YEAR ( d ), YEAR ( d ) - 1 ) RETURN "1 Apr – " & FORMAT ( d, "d MMM yyyy" )
		displayFolder: Enhanced
		lineageTag: 7d93a32c-ef15-4b80-9fc2-bbaa3b427a43

	/// Second line under the KPI.
	measure 'Incidents Compare' = VAR d = TODAY() VAR fyStart = IF ( MONTH ( d ) >= 4, YEAR ( d ), YEAR ( d ) - 1 ) RETURN "vs " & FORMAT ( [Incidents Same Time Last FY], "#,##0" ) & " same period FY" & RIGHT ( fyStart - 1, 2 ) & "/" & RIGHT ( fyStart, 2 )
		displayFolder: Enhanced
		lineageTag: bfdc24f8-6183-46d9-a0ba-35fcc669567d

	/// KPI title, Rolling 30.
	measure 'Rolling 30 Title' = "ROLLING 30 DAYS"
		displayFolder: Enhanced
		lineageTag: 177ff57c-91e2-4189-af78-4b02cde22c0d

	/// Delta pill text, Rolling 30.
	measure 'Rolling 30 Pill' = VAR c = [Incidents Rolling 30 Days] VAR p = [Incidents Prior 30 Days] RETURN IF ( ISBLANK ( p ) || ( p = 0 && c = 0 ), "— no comparison", IF ( p = 0, "▲ new", IF ( c > p, "▲ " & FORMAT ( DIVIDE ( c - p, p ), "0%" ) & " higher", IF ( c < p, "▼ " & FORMAT ( DIVIDE ( p - c, p ), "0%" ) & " lower", "— unchanged" ) ) ) )
		displayFolder: Enhanced
		lineageTag: 5afbec80-fd8f-42da-b66a-888b05acf881

	/// Pill font colour (hex). Higher is worse for every KPI on this page.
	measure 'Rolling 30 Pill Color' = VAR c = [Incidents Rolling 30 Days] VAR p = [Incidents Prior 30 Days] RETURN IF ( ISBLANK ( p ) || c = p, "#605E5C", IF ( c > p, "#CE3E39", "#2E8540" ) )
		displayFolder: Enhanced
		lineageTag: 06599501-1fcb-46d1-ac3b-26e7e8daa0dd

	/// Pill background colour (hex).
	measure 'Rolling 30 Pill Tint' = VAR c = [Incidents Rolling 30 Days] VAR p = [Incidents Prior 30 Days] RETURN IF ( ISBLANK ( p ) || c = p, "#EEF1F4", IF ( c > p, "#FDECEA", "#E6F4EA" ) )
		displayFolder: Enhanced
		lineageTag: e1dc9fec-2f88-4ffa-a7fb-fa7f7ad85689

	/// Grey text beside the pill.
	measure 'Rolling 30 Period' = VAR d = TODAY() RETURN FORMAT ( d - 29, "d MMM" ) & " – " & FORMAT ( d, "d MMM" )
		displayFolder: Enhanced
		lineageTag: a70ecab2-2db0-45d8-a0e9-3e9d775e562c

	/// Second line under the KPI.
	measure 'Rolling 30 Compare' = "vs " & FORMAT ( [Incidents Prior 30 Days], "#,##0" ) & " in the prior 30 days"
		displayFolder: Enhanced
		lineageTag: 507fd4ad-dff2-458c-80d7-ed0e4a22dd60

	/// KPI title, DOs.
	measure 'DOs Title' = "DANGEROUS OCCURRENCES — FYTD"
		displayFolder: Enhanced
		lineageTag: 16a6479b-bad1-4478-a6be-7f4ca0da4eb9

	/// Delta pill text, DOs.
	measure 'DOs Pill' = VAR c = [DOs FYTD] VAR p = [DOs Same Time Last FY] RETURN IF ( ISBLANK ( p ) || ( p = 0 && c = 0 ), "— no comparison", IF ( p = 0, "▲ new", IF ( c > p, "▲ " & FORMAT ( DIVIDE ( c - p, p ), "0%" ) & " higher", IF ( c < p, "▼ " & FORMAT ( DIVIDE ( p - c, p ), "0%" ) & " lower", "— unchanged" ) ) ) )
		displayFolder: Enhanced
		lineageTag: a07d8919-707b-44c1-a6e2-da84291affea

	/// Pill font colour (hex). Higher is worse for every KPI on this page.
	measure 'DOs Pill Color' = VAR c = [DOs FYTD] VAR p = [DOs Same Time Last FY] RETURN IF ( ISBLANK ( p ) || c = p, "#605E5C", IF ( c > p, "#CE3E39", "#2E8540" ) )
		displayFolder: Enhanced
		lineageTag: 617eb126-e1b4-4063-8547-0f4378ef18ed

	/// Pill background colour (hex).
	measure 'DOs Pill Tint' = VAR c = [DOs FYTD] VAR p = [DOs Same Time Last FY] RETURN IF ( ISBLANK ( p ) || c = p, "#EEF1F4", IF ( c > p, "#FDECEA", "#E6F4EA" ) )
		displayFolder: Enhanced
		lineageTag: 61c8329e-62d5-4101-9559-9b79cb17bc76

	/// Grey text beside the pill.
	measure 'DOs Period' = FORMAT ( [DO Share FYTD %], "0%" ) & " of incidents"
		displayFolder: Enhanced
		lineageTag: cfe80743-9809-4b12-885b-9ed17c50441a

	/// Second line under the KPI.
	measure 'DOs Compare' = VAR d = TODAY() VAR fyStart = IF ( MONTH ( d ) >= 4, YEAR ( d ), YEAR ( d ) - 1 ) RETURN "vs " & FORMAT ( [DOs Same Time Last FY], "#,##0" ) & " same period FY" & RIGHT ( fyStart - 1, 2 ) & "/" & RIGHT ( fyStart, 2 )
		displayFolder: Enhanced
		lineageTag: 104b2c20-d864-4a7c-af64-a31baa58f72c

	/// KPI title, Injuries.
	measure 'Injuries Title' = "INJURIES — FYTD"
		displayFolder: Enhanced
		lineageTag: 0d1450e1-a1f6-4b21-9cac-57b847887133

	/// Delta pill text, Injuries.
	measure 'Injuries Pill' = VAR c = [Injuries FYTD] VAR p = [Injuries Same Time Last FY] RETURN IF ( ISBLANK ( p ) || ( p = 0 && c = 0 ), "— no comparison", IF ( p = 0, "▲ new", IF ( c > p, "▲ " & FORMAT ( DIVIDE ( c - p, p ), "0%" ) & " higher", IF ( c < p, "▼ " & FORMAT ( DIVIDE ( p - c, p ), "0%" ) & " lower", "— unchanged" ) ) ) )
		displayFolder: Enhanced
		lineageTag: 729db436-c264-402b-9b0a-7fb4a4771645

	/// Pill font colour (hex). Higher is worse for every KPI on this page.
	measure 'Injuries Pill Color' = VAR c = [Injuries FYTD] VAR p = [Injuries Same Time Last FY] RETURN IF ( ISBLANK ( p ) || c = p, "#605E5C", IF ( c > p, "#CE3E39", "#2E8540" ) )
		displayFolder: Enhanced
		lineageTag: 31a2b6ab-6b2f-44b8-bea9-6e0b91fae008

	/// Pill background colour (hex).
	measure 'Injuries Pill Tint' = VAR c = [Injuries FYTD] VAR p = [Injuries Same Time Last FY] RETURN IF ( ISBLANK ( p ) || c = p, "#EEF1F4", IF ( c > p, "#FDECEA", "#E6F4EA" ) )
		displayFolder: Enhanced
		lineageTag: 72900cae-f95f-417a-a3e1-cfcf6ea3c874

	/// Grey text beside the pill.
	measure 'Injuries Period' = "Lost time & medical aid"
		displayFolder: Enhanced
		lineageTag: a975763c-859c-42e0-8efb-89d39ddfec6b

	/// Second line under the KPI.
	measure 'Injuries Compare' = VAR d = TODAY() VAR fyStart = IF ( MONTH ( d ) >= 4, YEAR ( d ), YEAR ( d ) - 1 ) RETURN "vs " & FORMAT ( [Injuries Same Time Last FY], "#,##0" ) & " same period FY" & RIGHT ( fyStart - 1, 2 ) & "/" & RIGHT ( fyStart, 2 )
		displayFolder: Enhanced
		lineageTag: c11ca67f-db24-49bb-b802-1df7b44b4285

	/// KPI title, Fatalities.
	measure 'Fatalities Title' = "FATALITIES — FYTD"
		displayFolder: Enhanced
		lineageTag: a5a92a83-a95e-4510-baf2-688ec6d8bbbb

	/// Delta pill text, Fatalities.
	measure 'Fatalities Pill' = VAR c = [Fatalities FYTD] VAR p = [Fatalities Same Time Last FY] RETURN IF ( ISBLANK ( p ) || ( p = 0 && c = 0 ), "— no comparison", IF ( p = 0, "▲ new", IF ( c > p, "▲ +" & FORMAT ( c - p, "0" ) & " higher", IF ( c < p, "▼ " & FORMAT ( c - p, "0" ) & " lower", "— unchanged" ) ) ) )
		displayFolder: Enhanced
		lineageTag: a85b18df-95b2-42a3-a371-7d6d6ac3e6fd

	/// Pill font colour (hex). Higher is worse for every KPI on this page.
	measure 'Fatalities Pill Color' = VAR c = [Fatalities FYTD] VAR p = [Fatalities Same Time Last FY] RETURN IF ( ISBLANK ( p ) || c = p, "#605E5C", IF ( c > p, "#CE3E39", "#2E8540" ) )
		displayFolder: Enhanced
		lineageTag: 52907bbe-ff39-4595-9c20-6cc5ed8be01f

	/// Pill background colour (hex).
	measure 'Fatalities Pill Tint' = VAR c = [Fatalities FYTD] VAR p = [Fatalities Same Time Last FY] RETURN IF ( ISBLANK ( p ) || c = p, "#EEF1F4", IF ( c > p, "#FDECEA", "#E6F4EA" ) )
		displayFolder: Enhanced
		lineageTag: 60142af4-59eb-4a8c-bb89-4298884d8f78

	/// Grey text beside the pill.
	measure 'Fatalities Period' = VAR l = [Most Recent Fatality Date] RETURN IF ( ISBLANK ( l ), "None recorded", "Last: " & FORMAT ( l, "d MMM yyyy" ) )
		displayFolder: Enhanced
		lineageTag: 93a5ccba-11dc-4212-a0de-48c91f9c384c

	/// Second line under the KPI.
	measure 'Fatalities Compare' = VAR d = TODAY() VAR fyStart = IF ( MONTH ( d ) >= 4, YEAR ( d ), YEAR ( d ) - 1 ) RETURN "vs " & FORMAT ( [Fatalities Same Time Last FY], "#,##0" ) & " same period FY" & RIGHT ( fyStart - 1, 2 ) & "/" & RIGHT ( fyStart, 2 )
		displayFolder: Enhanced
		lineageTag: 33668b18-4d22-426e-bbbb-59362fe5e4d4

	/// Yellow strip text.
	measure 'Alert Label' = VAR latest = CALCULATE ( MAX ( fact_mine_incident[reported_date] ), fact_mine_incident[reported_date] <= TODAY() ) RETURN "!   Data current through " & FORMAT ( latest, "d MMM yyyy" ) & ".  Incidents from the last few days may still be entered in CORE, so recent weeks can go up a little."
		displayFolder: Enhanced
		lineageTag: 4f4ac320-425b-4b45-bcb3-79b37192d972

	/// Header coverage text from the data, e.g. 'FY1999/00 → FY2026/27 YTD'.
	measure 'Coverage Label' = VAR first = CALCULATE ( MIN ( fact_mine_incident[effective_date] ), fact_mine_incident[effective_date] > DATE ( 2000, 1, 1 ) ) VAR fyF = IF ( MONTH ( first ) >= 4, YEAR ( first ), YEAR ( first ) - 1 ) VAR d = TODAY() VAR fyStart = IF ( MONTH ( d ) >= 4, YEAR ( d ), YEAR ( d ) - 1 ) RETURN "FY" & fyF & "/" & RIGHT ( fyF + 1, 2 ) & "  →  FY" & fyStart & "/" & RIGHT ( fyStart + 1, 2 ) & " YTD"
		displayFolder: Enhanced
		lineageTag: ac2ad3da-8481-4744-8748-142da97cfc55

	/// Trend columns: monthly incidents, trailing 24 months. Axis dim_date[fiscal_month_label].
	measure 'Total incidents' = VAR d = TODAY() VAR wStart = DATE ( YEAR ( d ) - 2, MONTH ( d ), 1 ) VAR wEnd = EOMONTH ( d, 0 ) + 1 RETURN CALCULATE ( DISTINCTCOUNT ( fact_mine_incident[mine_incident_id] ), USERELATIONSHIP ( fact_mine_incident[Effective_Date_SK], dim_date[Date_SK] ), fact_mine_incident[effective_date] >= wStart, fact_mine_incident[effective_date] < wEnd )
		formatString: #,##0
		displayFolder: Enhanced
		lineageTag: b832f51c-ceb0-4227-8128-7bf17f882995

	/// Trend line: DOs per month, same window.
	measure 'Dangerous Occurrences' = VAR d = TODAY() VAR wStart = DATE ( YEAR ( d ) - 2, MONTH ( d ), 1 ) VAR wEnd = EOMONTH ( d, 0 ) + 1 RETURN CALCULATE ( DISTINCTCOUNT ( fact_mine_incident[mine_incident_id] ), USERELATIONSHIP ( fact_mine_incident[Effective_Date_SK], dim_date[Date_SK] ), fact_mine_incident[is_dangerous_occurrence] = 1, fact_mine_incident[effective_date] >= wStart, fact_mine_incident[effective_date] < wEnd )
		formatString: #,##0
		displayFolder: Enhanced
		lineageTag: 32e35be5-ee94-4f56-910f-369fcf1307a6

	/// Flat reference line, blank outside the window.
	measure '24-month average' = VAR d = TODAY() VAR wStart = DATE ( YEAR ( d ) - 2, MONTH ( d ), 1 ) VAR wEnd = EOMONTH ( d, 0 ) + 1 VAR tot = CALCULATE ( DISTINCTCOUNT ( fact_mine_incident[mine_incident_id] ), ALL ( dim_date ), fact_mine_incident[effective_date] >= wStart, fact_mine_incident[effective_date] < wEnd ) RETURN IF ( ISBLANK ( [Total incidents] ), BLANK (), DIVIDE ( tot, 24 ) )
		formatString: #,##0
		displayFolder: Enhanced
		lineageTag: e82d7002-58f9-41e0-b112-ff17aecab8ce

	/// Trend chart title.
	measure 'Trend Title' = "Incidents and Dangerous Occurrences"
		displayFolder: Enhanced
		lineageTag: 16a8952c-6a8f-49a8-a03d-03dde53daf74

	/// Trend chart subtitle, carries the average so the dashed line is explained.
	measure 'Trend Subtitle' = VAR d = TODAY() VAR tot = CALCULATE ( DISTINCTCOUNT ( fact_mine_incident[mine_incident_id] ), fact_mine_incident[effective_date] >= DATE ( YEAR ( d ) - 2, MONTH ( d ), 1 ), fact_mine_incident[effective_date] < EOMONTH ( d, 0 ) + 1 ) RETURN "Monthly, last 24 months  ·  average " & FORMAT ( DIVIDE ( tot, 24 ), "0" ) & " a month"
		displayFolder: Enhanced
		lineageTag: 8970653e-3c35-4ce4-a57a-a9288569f356

	/// Injuries per month, trailing 12 months.
	measure 'Injuries' = VAR d = TODAY() VAR wStart = DATE ( YEAR ( d ) - 1, MONTH ( d ), 1 ) VAR wEnd = EOMONTH ( d, 0 ) + 1 RETURN CALCULATE ( SUM ( fact_mine_incident[number_of_injuries] ), USERELATIONSHIP ( fact_mine_incident[Effective_Date_SK], dim_date[Date_SK] ), fact_mine_incident[effective_date] >= wStart, fact_mine_incident[effective_date] < wEnd )
		formatString: #,##0
		displayFolder: Enhanced
		lineageTag: 72459a28-3e65-4d77-a86e-7fe78b218bbc

	/// Fatalities per month, trailing 12 months.
	measure 'Fatalities' = VAR d = TODAY() VAR wStart = DATE ( YEAR ( d ) - 1, MONTH ( d ), 1 ) VAR wEnd = EOMONTH ( d, 0 ) + 1 RETURN CALCULATE ( SUM ( fact_mine_incident[number_of_fatalities] ), USERELATIONSHIP ( fact_mine_incident[Effective_Date_SK], dim_date[Date_SK] ), fact_mine_incident[effective_date] >= wStart, fact_mine_incident[effective_date] < wEnd )
		formatString: #,##0
		displayFolder: Enhanced
		lineageTag: 7872de5a-bd55-4aef-8420-ad4a74adb8d4

	/// Small chart title.
	measure 'Injuries Chart Title' = VAR d = TODAY() VAR fyStart = IF ( MONTH ( d ) >= 4, YEAR ( d ), YEAR ( d ) - 1 ) RETURN "INJURIES   " & FORMAT ( [Injuries FYTD], "#,##0" ) & " in FY" & RIGHT ( fyStart, 2 ) & "/" & RIGHT ( fyStart + 1, 2 ) & " to date"
		displayFolder: Enhanced
		lineageTag: 4262a0c7-8c9e-4881-9209-46d0acdcc0f2

	/// Small chart title.
	measure 'Fatalities Chart Title' = VAR l = [Most Recent Fatality Date] RETURN "FATALITIES   " & IF ( ISBLANK ( l ), "none in the last 12 months", "most recent " & FORMAT ( l, "MMM yyyy" ) )
		displayFolder: Enhanced
		lineageTag: 1034c2bb-5edf-466e-ba83-0cd8ab70e57c

	/// Top-5 panel: incidents in the last 28 days per parent category group, self-trimming to the top 5.
	measure 'Last 4 weeks' = VAR Base = CALCULATE ( DISTINCTCOUNT ( fact_mine_incident[mine_incident_id] ), USERELATIONSHIP ( fact_mine_incident[Effective_Date_SK], dim_date[Date_SK] ), fact_mine_incident[effective_date] >= DATE ( 2018, 5, 21 ), bridge_incident_category[is_uncategorised] = 0, fact_mine_incident[effective_date] > TODAY() - 28, fact_mine_incident[effective_date] < TODAY() + 1 ) VAR Ranked = RANKX ( ALLSELECTED ( dim_incident_category[category_group] ), CALCULATE ( DISTINCTCOUNT ( fact_mine_incident[mine_incident_id] ), USERELATIONSHIP ( fact_mine_incident[Effective_Date_SK], dim_date[Date_SK] ), fact_mine_incident[effective_date] >= DATE ( 2018, 5, 21 ), bridge_incident_category[is_uncategorised] = 0, fact_mine_incident[effective_date] > TODAY() - 28, fact_mine_incident[effective_date] < TODAY() + 1 ), , DESC, DENSE ) RETURN IF ( ISBLANK ( Ranked ) || Ranked <= 5, Base )
		formatString: #,##0
		displayFolder: Enhanced
		lineageTag: e23b7528-f9b8-4727-88b1-630c88340811

	/// The 28 days before that.
	measure 'Previous 4 weeks' = IF ( ISBLANK ( [Last 4 weeks] ), BLANK (), CALCULATE ( DISTINCTCOUNT ( fact_mine_incident[mine_incident_id] ), USERELATIONSHIP ( fact_mine_incident[Effective_Date_SK], dim_date[Date_SK] ), fact_mine_incident[effective_date] >= DATE ( 2018, 5, 21 ), bridge_incident_category[is_uncategorised] = 0, fact_mine_incident[effective_date] > TODAY() - 56, fact_mine_incident[effective_date] <= TODAY() - 28 ) )
		formatString: #,##0
		displayFolder: Enhanced
		lineageTag: 164b367d-c588-40d0-8183-1df2605265b3

	/// Arrow + change for the top-5 list.
	measure 'Change' = VAR c = [Last 4 weeks] VAR p = [Previous 4 weeks] RETURN IF ( ISBLANK ( c ), BLANK (), IF ( c > p, "▲ " & ( c - p ), IF ( c < p, "▼ " & ( p - c ), "—" ) ) )
		displayFolder: Enhanced
		lineageTag: 8c3b4144-0118-44b0-8ccf-84a5dc0fd391

	/// Font colour for the change column.
	measure 'Change Color' = VAR c = [Last 4 weeks] VAR p = [Previous 4 weeks] RETURN IF ( ISBLANK ( c ) || c = p, "#605E5C", IF ( c > p, "#CE3E39", "#2E8540" ) )
		displayFolder: Enhanced
		lineageTag: 479ed12f-808a-4d1c-93de-90164c39367d

	/// Panel title.
	measure 'Top 5 Title' = "Top 5 incident types"
		displayFolder: Enhanced
		lineageTag: e4f64011-94d0-4681-ac35-a2673e96b163

	/// Current, non-deleted mines whose operation status reads as operating. Source: CORE mine register via dim_mine. Definition to confirm with Raj.
	measure 'Active mines operating' = CALCULATE ( DISTINCTCOUNT ( dim_mine[mine_guid] ), SEARCH ( "operat", dim_mine[mine_operation_status_desc], 1, 0 ) > 0, NOT CONTAINSSTRING ( dim_mine[mine_operation_status_desc], "Not" ), dim_mine[deleted_ind] = FALSE (), dim_mine[dl_iscurrent] = TRUE () )
		formatString: #,##0
		displayFolder: Enhanced
		lineageTag: c9b037b4-7619-4b9d-a108-7792f2069e5d

	/// Incidents FYTD ÷ active mines × 100.
	measure 'Incidents per 100 active mines' = DIVIDE ( [Incidents FYTD], [Active mines operating] ) * 100
		formatString: #,##0.0
		displayFolder: Enhanced
		lineageTag: c4409912-9c08-454f-a33a-03c41d6b4139

	/// Region chart title.
	measure 'Region Title' = VAR d = TODAY() VAR fyStart = IF ( MONTH ( d ) >= 4, YEAR ( d ), YEAR ( d ) - 1 ) RETURN "Incidents and DOs by region"
		displayFolder: Enhanced
		lineageTag: bcdf991b-aeba-4859-b934-3a89c8d01863

	/// Region chart subtitle.
	measure 'Region Subtitle' = VAR d = TODAY() VAR fyStart = IF ( MONTH ( d ) >= 4, YEAR ( d ), YEAR ( d ) - 1 ) RETURN "FY" & RIGHT ( fyStart, 2 ) & "/" & RIGHT ( fyStart + 1, 2 ) & " to date  ·  select a region to filter this page"
		displayFolder: Enhanced
		lineageTag: ff9912e3-0e04-443a-8fdd-fac036a838be

	/// Alias for the region chart legend ('Inc.').
	measure 'Incidents FYTD by Region' = [Incidents FYTD]
		formatString: #,##0
		displayFolder: Enhanced
		lineageTag: 56f94928-5079-4ad7-b8af-3b0612c4cae8

	/// Alias for the region chart legend ('DOs').
	measure 'DOs FYTD by Region' = [DOs FYTD]
		formatString: #,##0
		displayFolder: Enhanced
		lineageTag: db38a8ef-3fef-4efa-b58d-f90fa4709a38

	/// Title for the original report's FY chart.
	measure 'FY Chart Title' = "Incidents and Dangerous Occurrences by fiscal year  ·  last 5 completed years"
		displayFolder: Card Labels
		lineageTag: 942fb5e3-24d5-4e94-b909-ef58b556ca69

	/// Title for the original report's monthly chart.
	measure 'Monthly Chart Title' = "Incidents, DOs, injuries and fatalities by month  ·  last 4 years"
		displayFolder: Card Labels
		lineageTag: d9ee373e-cc7c-4f80-914a-e5b591c04201

	/// Title for the original report's category chart.
	measure 'Category Chart Title' = "Top 5 incident categories  ·  May 2018 onward"
		displayFolder: Card Labels
		lineageTag: d55be407-e34b-429a-9215-84efd2aa4c46

