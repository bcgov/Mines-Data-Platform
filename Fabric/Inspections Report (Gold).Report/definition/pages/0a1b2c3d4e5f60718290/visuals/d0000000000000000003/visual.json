            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "1. Number of inspections in FY 26/27      2. Number of Inspections same time last FY 25/26      3. Number of Inspections in the last month of current FY 26/27",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "12px",
                      "color": "#013366"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "All inspection types are included: Site Visit, Compliance Review, Inspection, Desktop, Meeting. Counts are distinct inspections based on inspection date. Meetings are not counted toward the Service Plan Target.",
                    "textStyle": {
                      "fontSize": "12px",
                      "color": "#252423"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The line chart shows inspections per fiscal year (FY2019-FY2026), with the Service Plan Target (1,600/yr) as a dashed line. The bar chart shows inspections by fiscal month from April 2022, broken down by inspection type.",
                    "textStyle": {
                      "fontSize": "12px",
                      "color": "#252423"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Data current as of 7 July 2026 - gold layer refreshed; fiscal-year figures are up to date.",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "12px",
                      "color": "#8a6d1a"
                    }
                  },
                  {
                    "value": "Contact Raj (Rajneesh.1.Gulati@gov.bc.ca) or Nhung (Nhung.Nguyen@gov.bc.ca) for more information.",
                    "textStyle": {
                      "fontSize": "12px",
                      "color": "#605e5c"
                    }
                  }
                ]
              }
            ]
          }
        }
